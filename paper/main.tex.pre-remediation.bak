\title{Trigger Salience, Not Attacker Count, Governs\\ Backdoor Robustness in Federated Intrusion Detection}

% Anonymized for double-blind review (DLS / AISec). De-anonymize for camera-ready:
% replace the block below with the author name, affiliation, and email.
\author{\IEEEauthorblockN{Anonymous Author(s)}
\IEEEauthorblockA{Paper \#---\\
Submission under double-blind review}
