\begin{frontmatter}

\title{A Silent Measurement Hazard in PyTorch Federated Learning: When
Byzantine-Robust Aggregators Decide on a BatchNorm Counter}

%---------------------------------------------------------------------
% AUTHOR BLOCK
%---------------------------------------------------------------------
\author[mcs]{Usama Mustafa\corref{cor1}}
